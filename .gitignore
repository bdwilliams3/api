# Ignore all shell scripts
*.sh
*.bash
*.zsh
*.ksh
*.fish

# Ignore all Markdown files
*.md
*.markdown
*.mdown
*.mkd

#ignore virtualenv
*virtualenv
*venv
*.venv
*.env

# Ignore all graphviz files
*.dot

# Common README markdown names
README.md
README.markdown

# Ignore Istio directory
istio-1.28.2

# Ensure .gitignore itself remains tracked
!.gitignore

# --- Security tooling (re-include despite the *.sh / *.md ignores above) ---
!README.md
!security/*.sh
!security/*.md

# Scanner raw artifacts stay local (only the .md reports are committed)
security/artifacts/
__pycache__/
*.pyc
/k-api